<script>

function toggleNav(){
  const nav=document.getElementById('side-nav');
  const ov=document.getElementById('nav-overlay');
  nav.classList.toggle('open');
  ov.classList.toggle('open');
}
function goSlide(n){
  const el=document.getElementById('slide-'+n);
  if(el){
    el.scrollIntoView({behavior:'smooth',block:'start'});
    // close nav after a short delay
    setTimeout(()=>{
      document.getElementById('side-nav').classList.remove('open');
      document.getElementById('nav-overlay').classList.remove('open');
    },400);
  }
}
// Keyboard navigation
document.addEventListener('keydown',function(e){
  const slides=document.querySelectorAll('.slide');
  let current=0;
  slides.forEach((s,i)=>{
    const r=s.getBoundingClientRect();
    if(r.top<=100&&r.bottom>0)current=i;
  });
  if(e.key==='ArrowDown'||e.key==='PageDown'){
    e.preventDefault();
    if(current<slides.length-1)slides[current+1].scrollIntoView({behavior:'smooth',block:'start'});
  }
  if(e.key==='ArrowUp'||e.key==='PageUp'){
    e.preventDefault();
    if(current>0)slides[current-1].scrollIntoView({behavior:'smooth',block:'start'});
  }
});


</script>
