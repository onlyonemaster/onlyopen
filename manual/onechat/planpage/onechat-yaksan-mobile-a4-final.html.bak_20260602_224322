/* ══════════════════════════════════════════
   A4 PORTRAIT & MOBILE RESPONSIVE OVERRIDES
══════════════════════════════════════════ */

/* Update root variables for A4 portrait */
:root {
  --slide-w: 794px;  /* A4 width at 96 DPI */
  --slide-h: 1123px; /* A4 height at 96 DPI */
}

/* Ensure Korean font support */
body, html {
  font-family: 'Noto Sans KR', 'Malgun Gothic', 'Apple SD Gothic Neo', '맑은 고딕', 'Segoe UI', sans-serif !important;
}

/* Base mobile-first adjustments */
.slide {
  width: 100%;
  max-width: var(--slide-w);
  min-height: auto;
  margin: 0 auto;
}

/* Tablet and above */
@media (min-width: 768px) {
  .slide {
    width: 95%;
    max-width: var(--slide-w);
  }

  .slides-wrap {
    padding: 20px 0 80px;
  }
}

/* Mobile portrait (< 768px) */
@media (max-width: 767px) {
  /* Typography scaling */
  .slide-title {
    font-size: clamp(28px, 6vw, 52px);
  }

  .slide-subtitle {
    font-size: clamp(18px, 4vw, 26px);
  }

  .slide-desc {
    font-size: clamp(16px, 3.5vw, 22px);
  }

  .slide-tag {
    font-size: clamp(11px, 2.5vw, 13px);
  }

  /* Slide body padding */
  .slide-body {
    padding: 24px 20px;
  }

  /* Cover slide adjustments */
  .cover-body {
    flex-direction: column;
    padding: 24px 20px;
    gap: 24px;
  }

  .cover-right {
    align-items: center;
    width: 100%;
  }

  .cover-main-title {
    font-size: clamp(32px, 7vw, 58px);
  }

  .cover-sub {
    font-size: clamp(16px, 3.5vw, 24px);
  }

  /* Grid layouts to single column */
  .card-grid-2,
  .card-grid-3,
  .card-grid-4,
  .toc-grid,
  .pkg-cards {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .two-col,
  .two-col-6-4 {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  /* Stat row to column */
  .stat-row {
    flex-direction: column;
    gap: 12px;
  }

  /* VS layout to column */
  .vs-row {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .vs-mid {
    display: none;
  }

  /* Step flow to column */
  .step-flow {
    flex-direction: column;
    gap: 12px;
  }

  .step-arrow {
    transform: rotate(90deg);
  }

  /* Flow big to column */
  .flow-big {
    flex-direction: column;
    gap: 12px;
  }

  .fb-arrow {
    transform: rotate(90deg);
  }

  /* Timeline adjustments */
  .timeline {
    flex-direction: column;
    gap: 24px;
  }

  .timeline::before {
    display: none;
  }

  /* Section slide */
  .section-inner {
    padding: 24px 20px;
  }

  .section-part-num {
    font-size: clamp(60px, 15vw, 120px);
  }

  .section-title {
    font-size: clamp(32px, 7vw, 60px);
  }

  .section-desc {
    font-size: clamp(16px, 3.5vw, 24px);
  }

  /* CTA slide */
  .cta-inner {
    padding: 24px 20px;
  }

  .cta-title {
    font-size: clamp(32px, 7vw, 60px);
  }

  .cta-sub {
    font-size: clamp(16px, 4vw, 26px);
  }

  .cta-btn {
    font-size: clamp(16px, 4vw, 22px);
    padding: 14px 32px;
  }

  /* Table responsive */
  .comp-table {
    font-size: 14px;
  }

  .comp-table th,
  .comp-table td {
    padding: 10px 12px;
  }

  /* Navigation adjustments */
  #nav-toggle {
    width: 48px;
    height: 48px;
    top: 16px;
    right: 16px;
  }

  #side-nav {
    width: 90%;
    max-width: 320px;
  }

  /* Slide bar */
  .slide-bar {
    padding: 12px 16px;
  }

  .slide-bar .brand {
    font-size: 13px;
  }

  .slide-bar .page-num {
    font-size: 11px;
  }
}

/* Small mobile (< 480px) */
@media (max-width: 479px) {
  .slide-body {
    padding: 20px 16px;
  }

  .cover-body,
  .section-inner,
  .cta-inner {
    padding: 20px 16px;
  }

  .info-card {
    padding: 16px;
  }

  .feat-item {
    padding: 16px 18px;
  }

  .slide-bar {
    padding: 10px 12px;
  }
}

/* Print styles for A4 paper */
@media print {
  @page {
    size: A4 portrait;
    margin: 0;
  }

  .slide {
    width: 210mm;
    height: 297mm;
    page-break-after: always;
    border-radius: 0;
    box-shadow: none;
  }

  #nav-toggle,
  #nav-overlay,
  #side-nav {
    display: none !important;
  }

  .slides-wrap {
    padding: 0;
    gap: 0;
  }
}

/* Landscape orientation alert for mobile */
@media (max-width: 767px) and (orientation: landscape) {
  body::before {
    content: '📱 세로 모드로 회전하시면 더 나은 화면을 볼 수 있습니다';
