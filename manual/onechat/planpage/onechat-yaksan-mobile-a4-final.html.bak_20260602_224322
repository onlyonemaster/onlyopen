<!DOCTYPE html>

<html lang="ko">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" name="viewport"/>
<meta content="원챗 시스템 × 약산샘물·태백산수음료 임원 제안서 2026 - 모바일 최적화 A4 세로 버전" name="description"/>
<meta content="#0a1628" name="theme-color"/>
<title>원챗 시스템 × 약산샘물 — 임원 제안서 2026 (51p)</title>
<style>

/* ══════════════════════════════════════════
   MOBILE-OPTIMIZED A4 PORTRAIT LAYOUT
   Korean Character Support - UTF-8
══════════════════════════════════════════ */

/* Keep original CSS */

/* ══════════════════════════════════════════
   RESET & ROOT
══════════════════════════════════════════ */
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --gold:   #e8c96a;
  --gold2:  #f5d98b;
  --navy:   #0a1628;
  --navy2:  #0f2040;
  --navy3:  #162b55;
  --blue:   #1e5fad;
  --sky:    #3b9dd8;
  --white:  #ffffff;
  --off:    #e8edf5;
  --muted:  #8ca0c0;
  --accent: #f0a500;
  --green:  #22c55e;
  --red:    #ef4444;
  --slide-w:1280px;
  --slide-h:720px;
}

html,body{
  width:100%;
  background:#050d1a;
  font-family:'Apple SD Gothic Neo','Noto Sans KR','Malgun Gothic',sans-serif;
  overflow-x:hidden;
}

/* ══════════════════════════════════════════
   SLIDE WRAPPER
══════════════════════════════════════════ */
.slides-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:40px 0 100px;
  gap:12px;
}

.slide{
  width:var(--slide-w);
  min-height:var(--slide-h);
  background:var(--navy);
  border-radius:10px;
  border:1px solid rgba(232,201,106,0.15);
  overflow:hidden;
  position:relative;
  display:flex;
  flex-direction:column;
  box-shadow:0 8px 40px rgba(0,0,0,0.6);
  scroll-margin-top:20px;
}

/* ══════════════════════════════════════════
   SLIDE HEADER BAR
══════════════════════════════════════════ */
.slide-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:14px 32px;
  background:rgba(10,22,40,0.9);
  border-bottom:2px solid rgba(232,201,106,0.3);
  flex-shrink:0;
}
.slide-bar .brand{
  font-size:15px;
  font-weight:800;
  color:var(--gold);
  letter-spacing:1px;
}
.slide-bar .page-num{
  font-size:13px;
  color:var(--muted);
  font-weight:600;
}
.slide-bar .part-tag{
  font-size:12px;
  font-weight:700;
  color:var(--navy);
  background:var(--gold);
  padding:4px 14px;
  border-radius:20px;
  letter-spacing:1px;
}

/* ══════════════════════════════════════════
   SLIDE BODY
══════════════════════════════════════════ */
.slide-body{
  flex:1;
  display:flex;
  flex-direction:column;
  padding:40px 51px;
  position:relative;
  overflow:hidden;
}

/* ══════════════════════════════════════════
   TYPOGRAPHY
══════════════════════════════════════════ */
.slide-tag{
  font-size:13px;
  font-weight:700;
  letter-spacing:3px;
  color:var(--gold);
  text-transform:uppercase;
  margin-bottom:16px;
  opacity:0.9;
}
.slide-title{
  font-size:52px;
  font-weight:900;
  line-height:1.15;
  color:var(--white);
  margin-bottom:12px;
  letter-spacing:-0.5px;
}
.slide-title .hl{
  color:var(--gold);
}
.slide-subtitle{
  font-size:26px;
  font-weight:600;
  color:var(--off);
  line-height:1.4;
  margin-bottom:32px;
}
.slide-desc{
  font-size:22px;
  color:var(--muted);
  line-height:1.7;
}

/* ══════════════════════════════════════════
   COVER SLIDE
══════════════════════════════════════════ */
.cover-bg{
  background:
    radial-gradient(ellipse 70% 60% at 80% 50%, rgba(30,95,173,0.25) 0%, transparent 70%),
    radial-gradient(ellipse 50% 70% at 10% 80%, rgba(232,201,106,0.12) 0%, transparent 60%),
    linear-gradient(160deg,#0a1628 0%,#0f2040 40%,#0a1628 100%);
}
.cover-body{
  flex:1;
  display:flex;
  align-items:center;
  padding:40px 51px;
  gap:60px;
}
.cover-left{flex:1.2;}
.cover-right{
  flex:0.8;
  display:flex;
  flex-direction:column;
  gap:20px;
  align-items:flex-end;
}
.cover-kpi{
  background:rgba(232,201,106,0.08);
  border:1px solid rgba(232,201,106,0.3);
  border-radius:12px;
  padding:18px 28px;
  text-align:center;
  min-width:200px;
}
.cover-kpi .k-val{
  font-size:38px;
  font-weight:900;
  color:var(--gold);
  line-height:1;
}
.cover-kpi .k-label{
  font-size:15px;
  color:var(--muted);
  margin-top:6px;
}
.cover-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:rgba(232,201,106,0.15);
  border:1px solid rgba(232,201,106,0.4);
  color:var(--gold2);
  font-size:14px;
  font-weight:700;
  padding:8px 20px;
  border-radius:30px;
  margin-bottom:20px;
  letter-spacing:1px;
}
.cover-main-title{
  font-size:58px;
  font-weight:900;
  line-height:1.1;
  color:var(--white);
  margin-bottom:20px;
}
.cover-main-title .gold{color:var(--gold);}
.cover-sub{
  font-size:24px;
  color:var(--off);
  line-height:1.6;
  margin-bottom:28px;
}
.cover-footer-info{
  display:flex;
  gap:32px;
  flex-wrap:wrap;
}
.cover-footer-info span{
  font-size:15px;
  color:var(--muted);
  border-left:2px solid var(--gold);
  padding-left:12px;
}

/* ══════════════════════════════════════════
   TOC SLIDE
══════════════════════════════════════════ */
.toc-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
  margin-top:8px;
}
.toc-item{
  display:flex;
  align-items:center;
  gap:18px;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:10px;
  padding:18px 22px;
  transition:all 0.2s;
}
.toc-item:hover{
  background:rgba(232,201,106,0.08);
  border-color:rgba(232,201,106,0.3);
}
.toc-num{
  font-size:28px;
  font-weight:900;
  color:var(--gold);
  min-width:44px;
  text-align:center;
}
.toc-info .toc-part{
  font-size:12px;
  font-weight:700;
  color:var(--gold);
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:4px;
}
.toc-info .toc-ttl{
  font-size:20px;
  font-weight:700;
  color:var(--white);
}
.toc-info .toc-pages{
  font-size:13px;
  color:var(--muted);
  margin-top:3px;
}

/* ══════════════════════════════════════════
   SECTION DIVIDER
══════════════════════════════════════════ */
.section-slide{
  background:
    radial-gradient(ellipse 60% 80% at 30% 50%, rgba(30,95,173,0.3) 0%, transparent 65%),
    linear-gradient(160deg,#0a1628 0%,#0e1e3a 100%);
}
.section-inner{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:40px 80px;
}
.section-part-num{
  font-size:120px;
  font-weight:900;
  color:rgba(232,201,106,0.12);
  line-height:1;
  margin-bottom:-20px;
}
.section-part-label{
  font-size:14px;
  font-weight:700;
  color:var(--gold);
  letter-spacing:4px;
  text-transform:uppercase;
  margin-bottom:20px;
}
.section-title{
  font-size:60px;
  font-weight:900;
  color:var(--white);
  line-height:1.1;
  margin-bottom:16px;
}
.section-title .gold{color:var(--gold);}
.section-desc{
  font-size:24px;
  color:var(--muted);
  line-height:1.6;
  max-width:640px;
}

/* ══════════════════════════════════════════
   CARD GRIDS
══════════════════════════════════════════ */
.card-grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-top:16px;
}
.card-grid-3{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:16px;
  margin-top:16px;
}
.card-grid-4{
  display:grid;
  grid-template-columns:1fr 1fr 1fr 1fr;
  gap:14px;
  margin-top:16px;
}
.info-card{
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:12px;
  padding:24px 24px;
}
.info-card.gold-border{
  border-color:rgba(232,201,106,0.4);
  background:rgba(232,201,106,0.06);
}
.info-card .ic-icon{
  font-size:36px;
  margin-bottom:12px;
  display:block;
}
.info-card .ic-title{
  font-size:20px;
  font-weight:700;
  color:var(--white);
  margin-bottom:8px;
}
.info-card .ic-desc{
  font-size:17px;
  color:var(--muted);
  line-height:1.6;
}

/* ══════════════════════════════════════════
   BIG STAT
══════════════════════════════════════════ */
.stat-row{
  display:flex;
  gap:24px;
  margin-top:20px;
}
.stat-box{
  flex:1;
  text-align:center;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:12px;
  padding:24px 16px;
}
.stat-box .sv{
  font-size:52px;
  font-weight:900;
  color:var(--gold);
  line-height:1;
}
.stat-box .sl{
  font-size:17px;
  color:var(--muted);
  margin-top:8px;
}
.stat-box.accent .sv{color:var(--sky);}
.stat-box.green .sv{color:var(--green);}

/* ══════════════════════════════════════════
   PROBLEM / SOLUTION LAYOUT
══════════════════════════════════════════ */
.vs-row{
  display:grid;
  grid-template-columns:1fr 80px 1fr;
  gap:0;
  margin-top:16px;
  align-items:stretch;
}
.vs-side{
  border-radius:12px;
  padding:28px 28px;
}
.vs-side.bad{
  background:rgba(239,68,68,0.08);
  border:1px solid rgba(239,68,68,0.25);
}
.vs-side.good{
  background:rgba(34,197,94,0.08);
  border:1px solid rgba(34,197,94,0.25);
}
.vs-label{
  font-size:14px;
  font-weight:700;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:16px;
}
.vs-side.bad .vs-label{color:#f87171;}
.vs-side.good .vs-label{color:#4ade80;}
.vs-items{list-style:none;display:flex;flex-direction:column;gap:12px;}
.vs-items li{
  font-size:19px;
  color:var(--off);
  padding-left:8px;
  line-height:1.4;
}
.vs-items li::before{content:'❌ ';}
.vs-side.good .vs-items li::before{content:'✅ ';}
.vs-mid{
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:36px;
}

/* ══════════════════════════════════════════
   STEP FLOW
══════════════════════════════════════════ */
.step-flow{
  display:flex;
  align-items:stretch;
  gap:0;
  margin-top:20px;
  flex-wrap:nowrap;
}
.step-box{
  flex:1;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:10px;
  padding:20px 16px;
  text-align:center;
  position:relative;
}
.step-box .sn{
  width:36px;height:36px;
  background:var(--gold);
  color:var(--navy);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:18px;font-weight:900;
  margin:0 auto 12px;
}
.step-box .si{font-size:30px;margin-bottom:8px;display:block;}
.step-box .st{font-size:16px;font-weight:700;color:var(--white);margin-bottom:6px;}
.step-box .sd{font-size:14px;color:var(--muted);line-height:1.4;}
.step-arrow{
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  color:var(--gold);
  padding:0 4px;
  flex-shrink:0;
}

/* ══════════════════════════════════════════
   FEATURE LIST
══════════════════════════════════════════ */
.feat-list{
  display:flex;
  flex-direction:column;
  gap:16px;
  margin-top:16px;
}
.feat-item{
  display:flex;
  align-items:flex-start;
  gap:20px;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:10px;
  padding:20px 24px;
}
.feat-item .fi-icon{
  font-size:34px;
  flex-shrink:0;
  line-height:1;
}
.feat-item .fi-body .fi-title{
  font-size:22px;
  font-weight:700;
  color:var(--white);
  margin-bottom:6px;
}
.feat-item .fi-body .fi-desc{
  font-size:18px;
  color:var(--muted);
  line-height:1.6;
}

/* ══════════════════════════════════════════
   COMPARISON TABLE
══════════════════════════════════════════ */
.comp-table{
  width:100%;
  border-collapse:separate;
  border-spacing:0;
  margin-top:16px;
}
.comp-table th{
  background:rgba(232,201,106,0.15);
  color:var(--gold);
  font-size:17px;
  font-weight:700;
  padding:14px 20px;
  text-align:center;
  border-bottom:2px solid rgba(232,201,106,0.3);
}
.comp-table th:first-child{text-align:left;}
.comp-table td{
  padding:14px 20px;
  font-size:17px;
  color:var(--off);
  border-bottom:1px solid rgba(255,255,255,0.05);
  text-align:center;
  vertical-align:middle;
}
.comp-table td:first-child{
  text-align:left;
  font-weight:600;
  color:var(--white);
}
.comp-table tr:last-child td{border-bottom:none;}
.comp-table .yes{color:var(--green);font-size:20px;}
.comp-table .no{color:var(--red);font-size:20px;}
.comp-table .best td{background:rgba(232,201,106,0.07);}

/* ══════════════════════════════════════════
   BIG FLOW DIAGRAM
══════════════════════════════════════════ */
.flow-big{
  display:flex;
  align-items:center;
  gap:0;
  margin-top:20px;
  flex-wrap:nowrap;
  overflow-x:auto;
}
.fb-node{
  flex:1;
  min-width:130px;
  text-align:center;
  background:rgba(255,255,255,0.05);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:12px;
  padding:18px 12px;
}
.fb-node.gold{
  background:rgba(232,201,106,0.12);
  border-color:rgba(232,201,106,0.4);
}
.fb-node .fn-icon{font-size:32px;display:block;margin-bottom:8px;}
.fb-node .fn-step{
  font-size:11px;
  font-weight:700;
  color:var(--gold);
  letter-spacing:2px;
  margin-bottom:4px;
}
.fb-node .fn-title{
  font-size:15px;
  font-weight:700;
  color:var(--white);
  line-height:1.3;
}
.fb-arrow{
  font-size:24px;
  color:var(--gold);
  padding:0 4px;
  flex-shrink:0;
}

/* ══════════════════════════════════════════
   ROI / HIGHLIGHT BOX
══════════════════════════════════════════ */
.highlight-box{
  background:rgba(232,201,106,0.1);
  border:2px solid rgba(232,201,106,0.4);
  border-radius:14px;
  padding:28px 32px;
  margin-top:20px;
  text-align:center;
}
.highlight-box .hb-val{
  font-size:64px;
  font-weight:900;
  color:var(--gold);
  line-height:1;
}
.highlight-box .hb-label{
  font-size:22px;
  color:var(--off);
  margin-top:10px;
}

/* ══════════════════════════════════════════
   TIMELINE / ROADMAP
══════════════════════════════════════════ */
.timeline{
  display:flex;
  gap:0;
  margin-top:24px;
  position:relative;
}
.timeline::before{
  content:'';
  position:absolute;
  top:32px;left:0;right:0;
  height:3px;
  background:rgba(232,201,106,0.3);
}
.tl-item{
  flex:1;
  text-align:center;
  position:relative;
  padding-top:60px;
  padding-left:8px;
  padding-right:8px;
}
.tl-dot{
  width:24px;height:24px;
  background:var(--gold);
  border-radius:50%;
  position:absolute;
  top:21px;
  left:50%;
  transform:translateX(-50%);
  z-index:1;
}
.tl-dot.active{
  width:32px;height:32px;
  top:17px;
  background:var(--accent);
  box-shadow:0 0 20px rgba(240,165,0,0.5);
}
.tl-phase{
  font-size:12px;
  font-weight:700;
  color:var(--gold);
  letter-spacing:1.5px;
  text-transform:uppercase;
  margin-bottom:8px;
}
.tl-title{
  font-size:19px;
  font-weight:700;
  color:var(--white);
  margin-bottom:8px;
}
.tl-desc{
  font-size:15px;
  color:var(--muted);
  line-height:1.5;
}
.tl-date{
  font-size:13px;
  color:var(--gold);
  font-weight:700;
  margin-top:8px;
}

/* ══════════════════════════════════════════
   TWO-COLUMN LAYOUT
══════════════════════════════════════════ */
.two-col{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:32px;
  margin-top:16px;
  align-items:start;
}
.two-col-6-4{
  display:grid;
  grid-template-columns:1.4fr 1fr;
  gap:32px;
  margin-top:16px;
  align-items:start;
}

/* ══════════════════════════════════════════
   MANUAL CARDS
══════════════════════════════════════════ */
.manual-steps{
  display:flex;
  flex-direction:column;
  gap:14px;
  margin-top:12px;
}
.manual-step{
  display:flex;
  align-items:center;
  gap:20px;
  background:rgba(255,255,255,0.04);
  border-left:4px solid var(--gold);
  border-radius:0 10px 10px 0;
  padding:16px 22px;
}
.ms-num{
  width:42px;height:42px;
  background:var(--gold);
  color:var(--navy);
  border-radius:50%;
  font-size:20px;
  font-weight:900;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.ms-title{
  font-size:20px;
  font-weight:700;
  color:var(--white);
}
.ms-desc{
  font-size:16px;
  color:var(--muted);
  margin-top:3px;
}

/* ══════════════════════════════════════════
   PRICE / PACKAGE
══════════════════════════════════════════ */
.pkg-cards{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:20px;
  margin-top:20px;
}
.pkg-card{
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:14px;
  padding:28px 24px;
  text-align:center;
}
.pkg-card.featured{
  background:rgba(232,201,106,0.1);
  border:2px solid rgba(232,201,106,0.5);
  position:relative;
}
.pkg-card .pk-badge{
  position:absolute;
  top:-14px;left:50%;transform:translateX(-50%);
  background:var(--gold);
  color:var(--navy);
  font-size:12px;
  font-weight:800;
  padding:4px 16px;
  border-radius:20px;
  white-space:nowrap;
}
.pkg-card .pk-name{
  font-size:20px;font-weight:700;
  color:var(--muted);margin-bottom:8px;
}
.pkg-card .pk-price{
  font-size:40px;font-weight:900;
  color:var(--white);line-height:1;margin-bottom:6px;
}
.pkg-card .pk-unit{font-size:16px;color:var(--muted);}
.pkg-card .pk-features{
  list-style:none;margin-top:16px;
  display:flex;flex-direction:column;gap:10px;
}
.pkg-card .pk-features li{
  font-size:16px;color:var(--off);
  display:flex;align-items:center;gap:8px;
}
.pkg-card .pk-features li::before{
  content:'✓';color:var(--green);font-weight:700;
}

/* ══════════════════════════════════════════
   CTA / CLOSING
══════════════════════════════════════════ */
.cta-slide{
  background:
